# Bark 推送地址。推荐直接填 Bark App 里复制的完整测试 URL，例如 https://api.day.app/xxxx
BARK_ENDPOINT=

# 也可以只填 Bark key；自建服务端时配合 BARK_SERVER 使用
BARK_KEY=
BARK_SERVER=https://api.day.app
BARK_GROUP=股票提醒
BARK_LEVEL=
BARK_SOUND=
BARK_URL=

# Server 酱 SendKey，适合推送到个人微信
SERVERCHAN_SENDKEY=

# 企业微信群机器人 Webhook，适合推送到企业微信群
WECOM_BOT_WEBHOOK=

# 推送通道：bark,serverchan,wecom，可只填一个
PUSH_CHANNELS=bark

# 指南针 API。没有正式 API 文档时可以留空，程序会继续读取 data/compass 里的导出文件。
# COMPASS_API_ENDPOINT_TEMPLATE 可以填完整地址，也可以填相对路径，例如 /stock/{code}/summary
COMPASS_API_BASE_URL=
COMPASS_API_ENDPOINT_TEMPLATE=
COMPASS_API_TOKEN=
COMPASS_API_TIMEOUT=15
